# Reverse proxy con HTTPS (Let's Encrypt) e basic auth davanti alle dashboard.
# L'hash bcrypt della password NON sta nel repo: va in .env.live sul server
# come DASH_HASH (generalo con: docker run --rm caddy:2 caddy hash-password).
# I domini *.sslip.io risolvono automaticamente all'IP contenuto nel nome.
#
# Caddy gira in network_mode host (la dashboard di Paul binda 127.0.0.1
# hardcoded, irraggiungibile dalla rete bridge), quindi gli upstream sono le
# porte che ogni dashboard pubblica sul loopback del server, non i nomi dei
# servizi compose.

(auth) {
	basic_auth {
		trader {$DASH_HASH}
	}
}

sol.167.233.228.170.sslip.io {
	import auth
	reverse_proxy 127.0.0.1:8765
}

