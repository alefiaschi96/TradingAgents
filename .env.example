# ===== live/ Kraken Futures bot — copy to .env.live and fill in =====

# --- Secrets ---------------------------------------------------------------
OPENAI_API_KEY=
KRAKEN_API_KEY=                 # Kraken FUTURES API key (Futures > Settings > API)
KRAKEN_API_SECRET=              # ...permissions: Futures Trading. NO withdrawal.

# --- Instrument ------------------------------------------------------------
SYMBOL=PF_ETHUSD                # Kraken Futures perpetual id (PF_XBTUSD, PF_ETHUSD, ...)
# ANALYSIS_SYMBOL=SOL-USD       # optional; auto-derived from SYMBOL if unset

# --- Sizing / risk ---------------------------------------------------------
LEVERAGE=10                      # target leverage (isolated margin)
MAX_LEVERAGE=10                  # hard cap; bot refuses to exceed
STOP_PCT=0.5                    # +/- percent of entry (used when STOP_MODE=fixed, or as ATR fallback)
STOP_MODE=atr                   # fixed (use STOP_PCT) | atr (stop scaled to recent volatility)  [paper-sim]
STOP_ATR_MULT=1               # stop distance = this x ATR          (when STOP_MODE=atr)         [paper-sim]
ATR_PERIOD=10                   # number of bars used to compute the ATR                          [paper-sim]
ATR_TIMEFRAME=15m               # timeframe of the ATR bars                                       [paper-sim]
TAKE_PROFIT_RR=2.7             # take-profit distance = this x stop distance (1.0 = symmetric)    [paper-sim]
SLIPPAGE_PCT_PER_SIDE=0.02      # adverse fill slippage modelled on each side (entry + exit)       [paper-sim]
REGIME_FILTER=true              # veto trades that fight the trend / fire in chop / chase extremes  [paper-sim]
REGIME_TIMEFRAME=15m             # higher timeframe read for the trend                              [paper-sim]
REGIME_EMA_PERIOD=20            # EMA period (in regime bars) defining the trend                   [paper-sim]
REGIME_MAX_STRETCH_ATR=2.0      # veto if price is more than this many ATRs from the regime EMA (2.0: cut late chasing entries)  [paper-sim]
ANALYST_GATE=true               # veto entries the market analyst does not back (HOLD/no-data/opposite); also stops the analysis early (skips debate/PM) on HOLD/no-data
PREDICTION_MARKETS=false         # Polymarket off: gamma-api.polymarket.com is network-blocked in IT (SSL/DNS)
DECISION_INTERVAL_MIN=45       # periodic re-check of a standing trend (cheap now: HOLD cycles short-circuit)  [paper-sim]
ANALYSIS_MIN_GAP_MIN=30        # regime flip (chop->trend / trend flip) triggers analysis early, but never closer than this  [paper-sim]
ENTRY_MODE=plan                 # plan = the PM entry legs rest as conditional OCO orders (pullback limit / breakout stop-entry, first fill wins, TTL below) | market = enter immediately at the current price  [paper-sim]
ENTRY_TTL_MIN=120               # pending conditional entries expire after this many minutes without a fill (then the bot re-analyses)  [paper-sim]
ENTRY_MAX_STOP_WIDEN=2.0        # cap on widening the SL to the plan invalidation level, as a multiple of the ATR stop distance; size is scaled down to keep dollar risk constant  [paper-sim]
PROFIT_LOCK_PCT=0             # once price gets within this % of the TP, that level becomes a profit floor: if price comes back to it the trade closes there in gain (TP still active above); 0 = off  [paper-sim]
CONDITIONAL_HOLDS=true          # a HOLD that names a nearby trigger level continues to debate/PM so it can become a resting conditional entry; false = every HOLD short-circuits as before  [paper-sim]
CONDITIONAL_MAX_ATR=2.0         # the named trigger must be within this many ATRs of the current price to qualify for the pass  [paper-sim]
# [paper-sim] knobs are applied by the paper-sim today; wiring them into the live runner
# is part of the going-live step.
BALANCE_PCT=0.98                # fraction of balance used as margin (2% left for fees)
MARGIN_CURRENCY=USD             # collateral currency read from the wallet
EQUITY_FLOOR_USD=0              # kill-switch: no new trades below this equity (0=off)

# --- Behaviour -------------------------------------------------------------
LIVE=false                      # false = log orders but DO NOT send them (start here)
NO_BROKER=false                 # true = OFFLINE test: no Kraken key, fake balance, public price
PAPER_BALANCE=108               # fake equity (USD) used when NO_BROKER=true (~100 EUR)
ALLOW_SHORT=true                # SELL/Underweight -> open short (false = long only)
REATTACH_STOPS=true             # re-place SL/TP if an open position is missing them
TRIGGER_SIGNAL=mark             # mark | index | last  (stop trigger reference)
# LONG_SIGNALS=Buy,Overweight   # ratings that open a long
# SHORT_SIGNALS=Sell,Underweight# ratings that open a short

# --- LLM / analysis --------------------------------------------------------
LLM_PROVIDER=openai
DEEP_MODEL=gpt-5.5
QUICK_MODEL=gpt-5.4-mini
TEMPERATURE=0.0
DEBATE_ROUNDS=1
ANALYSTS=market,news            # fundamentals dropped (no balance sheet); social dropped (noise/latency, no intraday edge)
STREAM_LLM=true                 # stream Gemini calls (avoids ~60s non-streaming connection cutoff)
ANALYSIS_MAX_ATTEMPTS=3         # retries if a transient network drop hits mid-analysis
ANALYSIS_TIMEOUT_SEC=600        # abort+retry an analysis that stalls past this many seconds (0=off)
# GOOGLE_THINKING_LEVEL=        # "" = model default; "low"/"high" to tune latency/quality
DEBUG=true                      # print every analyst/agent report as it runs (set false for production)

# LOG_LEVEL=INFO
